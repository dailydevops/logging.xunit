{
  "stryker-config": {
    "solution": "Logging.XUnit.slnx",
    "mutation-level": "Advanced",
    "reporters": ["html", "json", "dashboard", "progress"],
    "project-info": { "name": "github.com/dailydevops/logging.xunit" },
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "test-projects": [
      "tests/NetEvolve.Logging.XUnit.Tests.Integration/NetEvolve.Logging.XUnit.Tests.Integration.csproj",
      "tests/NetEvolve.Logging.XUnit.Tests.Unit/NetEvolve.Logging.XUnit.Tests.Unit.csproj"
    ],
    "coverage-analysis": "all",
    "mutate": ["**/*.cs", "!**/*.Designer.cs", "!**/*.g.cs", "!**/*.g.i.cs"],
    "test-runner": "mtp"
  }
}
